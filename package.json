{
  "name": "markview",
  "productName": "MarkView",
  "version": "1.0.0",
  "description": "가벼운 마크다운 편집기 & 뷰어 - 이미지, Mermaid 다이어그램, 수식까지 그대로 봅니다.",
  "author": {
    "name": "UnitConnect",
    "email": "kwhwang@unitconnect.net"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:packaged": "node scripts/run-e2e.mjs --packaged release/linux-unpacked",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux dir --publish never",
    "verify:package": "npm run pack:linux && npm run test:e2e:packaged",
    "verify:installer": "node scripts/verify-installer.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "dompurify": "^3.2.7",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "jsdom": "^30.0.1",
    "katex": "^0.16.25",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.12.1",
    "playwright-core": "^1.56.1",
    "resedit": "^3.0.2"
  }
}
